---
import '../styles/tokens.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  intro?: string;
  /** Overview pages render a banner; artefact pages do not. */
  banner?: boolean;
}

const { title, intro, banner = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');

const entries = await getCollection('research');

/**
 * The navigation follows the study's evidence streams, not the folder layout.
 * Stream membership and order come from the artefacts' own frontmatter, so the
 * research owns the structure and this file merely renders it.
 */
const streamScopes = entries
  .filter((e) => e.data.artefact_type === 'stream-scope')
  .sort((a, b) => (a.data.stream_order ?? 99) - (b.data.stream_order ?? 99));

const streams = streamScopes.map((scope) => ({
  scope,
  label: scope.data.name ?? scope.data.workstream ?? scope.id,
  // Two levels: pages, and pages nested under a group page. Membership and
  // order both come from the artefacts, so the research owns the structure.
  evidence: (() => {
    const all = entries
      .filter(
        (e) =>
          e.data.artefact_type !== 'stream-scope' &&
          e.data.workstream === scope.data.workstream
      )
      .sort((a, b) => (a.data.page_order ?? 50) - (b.data.page_order ?? 50));
    return all
      .filter((e) => !e.data.audit_parent)
      .map((e) => ({
        entry: e,
        children: e.data.audit_group
          ? all.filter((c) => c.data.audit_parent === e.data.audit_group)
          : [],
      }));
  })(),
}));

// Study-level artefacts, and anything not yet filed to a stream.
const unfiled = entries.filter(
  (e) => e.data.artefact_type !== 'stream-scope' && !e.data.workstream
);

// Phase two. Listed so the shape of the library is visible, marked absent
// rather than linked to pages that do not exist.
const designSystem = ['References', 'Elements', 'Components', 'Patterns'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · SCB Easy Knowledge Library</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip">Skip to main content</a>

    <header class="hdr">
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="sidenav"
      >
        <span class="bars" aria-hidden="true"></span>
        <span class="sr">Sections</span>
      </button>
      <a class="hdr-name" href="/">SCB Easy Knowledge Library</a>
    </header>

    <div class="shell">
      <nav class="sidenav" id="sidenav" aria-label="Primary">
        <section class="grp">
          <h2>About this Library</h2>
          <ul class="flat">
            <li>
              <a href="/" aria-current={here === '' ? 'page' : undefined}>Overview</a>
            </li>
          </ul>
        </section>

        <section class="grp">
          <h2>Research</h2>

          {/* Flat while the research is small — no accordions to open first. */}
          <ul class="flat">
            {unfiled.map((item) => (
              <li>
                <a
                  href={`/${item.id}`}
                  aria-current={here === `/${item.id}` ? 'page' : undefined}
                >
                  {item.data.name ?? item.data.title ?? item.id}
                </a>
              </li>
            ))}
          </ul>

          {
            /* Each stream collapses. A section opens itself when the page being
               read is inside it, so the reader never has to find their own
               place after following a link. */
            streams.map(({ scope, label, evidence }) => {
              const inStream =
                here === `/${scope.id}` ||
                evidence.some(
                  ({ entry: item, children }) =>
                    here === `/${item.id}` || children.some((c) => here === `/${c.id}`)
                );
              return (
                <details open={inStream}>
                  <summary>{label}</summary>
                  <ul>
                    <li>
                      <a
                        href={`/${scope.id}`}
                        aria-current={here === `/${scope.id}` ? 'page' : undefined}
                      >
                        Plan Overview
                      </a>
                    </li>
                    {evidence.map(({ entry: item, children }) =>
                      children.length ? (
                        <li class="sub">
                          {/* The summary toggles and nothing else. A link inside
                              a summary is invalid and browsers disagree on
                              whether a click navigates or opens — so the group's
                              own page is the first item instead, matching how a
                              stream exposes its Plan Overview. */}
                          <details open={children.some((c) => here === `/${c.id}`) || here === `/${item.id}`}>
                            <summary>{item.data.name ?? item.data.title ?? item.id}</summary>
                            <ul>
                              <li>
                                <a
                                  class="child"
                                  href={`/${item.id}`}
                                  aria-current={here === `/${item.id}` ? 'page' : undefined}
                                >
                                  Overview
                                </a>
                              </li>
                              {children.map((child) => (
                                <li>
                                  <a
                                    class:list={[
                                      'child',
                                      { retired: child.data.status === 'retired' },
                                    ]}
                                    href={`/${child.id}`}
                                    aria-current={here === `/${child.id}` ? 'page' : undefined}
                                  >
                                    {child.data.name ?? child.data.title ?? child.id}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </details>
                        </li>
                      ) : (
                        <li>
                          <a
                            href={`/${item.id}`}
                            class={item.data.status === 'retired' ? 'retired' : undefined}
                            aria-current={here === `/${item.id}` ? 'page' : undefined}
                          >
                            {item.data.name ?? item.data.title ?? item.id}
                          </a>
                        </li>
                      )
                    )}
                  </ul>
                </details>
              );
            })
          }
        </section>

        <section class="grp">
          <h2>Design System</h2>
          {
            designSystem.map((section) => (
              <details class="empty">
                <summary>{section}</summary>
                <ul>
                  <li class="note">Nothing here until tokens and components exist.</li>
                </ul>
              </details>
            ))
          }
        </section>
      </nav>

      <div class="body">
        {/* Populated from the page's own section headings. */}
        <nav class="tabs" data-tabs aria-label="On this page" hidden>
          <ul data-tablist />
        </nav>

        {banner && <div class="banner" role="presentation" />}

        <main id="main" class="content">
          <h1>{title}</h1>
          {intro && <p class="intro">{intro}</p>}
          <slot />
        </main>

        <footer class="content foot">
          <p>
            Generated from <code>product-context/</code> at build time. Nothing here is
            hand-maintained — edit the markdown, not the site. See ADR-1.
          </p>
        </footer>
      </div>
    </div>


    <script>
      /**
       * Keep the sidebar where the reader left it.
       *
       * Each page is a full document load, so the nav is rebuilt from scratch
       * and its scroll position resets to the top. On a long nav that throws
       * the reader back to the first section every time they open a page.
       *
       * Saved on unload, restored before paint so there is no visible jump.
       */
      // Mobile: the nav is hidden until asked for.
      const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.getElementById('sidenav');
      if (navToggle && nav) {
        navToggle.addEventListener('click', () => {
          const open = nav.hasAttribute('data-open');
          if (open) nav.removeAttribute('data-open');
          else nav.setAttribute('data-open', '');
          navToggle.setAttribute('aria-expanded', String(!open));
        });
      }

      const SIDENAV_KEY = 'sidenav-scroll';
      const sidenav = document.querySelector<HTMLElement>('.sidenav');
      if (sidenav) {
        const saved = sessionStorage.getItem(SIDENAV_KEY);
        if (saved) sidenav.scrollTop = Number(saved) || 0;

        const save = () => sessionStorage.setItem(SIDENAV_KEY, String(sidenav.scrollTop));
        sidenav.addEventListener('scroll', save, { passive: true });
        window.addEventListener('pagehide', save);

        // If the active item is out of view — arriving from a link elsewhere,
        // or a first visit — bring it into view instead of leaving it hidden.
        const current = sidenav.querySelector<HTMLElement>('[aria-current="page"]');
        if (current) {
          const navBox = sidenav.getBoundingClientRect();
          const itemBox = current.getBoundingClientRect();
          if (itemBox.top < navBox.top || itemBox.bottom > navBox.bottom) {
            current.scrollIntoView({ block: 'center' });
            save();
          }
        }
      }
    </script>

    <script>
      /**
       * Section navigation, built from the page's own <h2> headings.
       *
       * Generated at runtime rather than hand-listed, so it cannot drift from
       * the content — which matters most on artefact pages, where the headings
       * come from markdown in product-context.
       */
      const strip = document.querySelector<HTMLElement>('[data-tabs]');
      const list = document.querySelector<HTMLElement>('[data-tablist]');
      const main = document.getElementById('main');

      if (strip && list && main) {
        const slug = (text: string) =>
          text
            .toLowerCase()
            .trim()
            .replace(/[^\p{L}\p{N}]+/gu, '-')
            .replace(/^-+|-+$/g, '');

        const headings = [...main.querySelectorAll<HTMLElement>('h2')];

        if (headings.length > 1) {
          strip.hidden = false;

          headings.forEach((h) => {
            if (!h.id) h.id = slug(h.textContent ?? '');
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `#${h.id}`;
            a.textContent = h.textContent;
            a.dataset.for = h.id;
            li.appendChild(a);
            list.appendChild(li);
          });

          const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];

          const mark = (id: string) => {
            links.forEach((a) => {
              const on = a.dataset.for === id;
              a.setAttribute('aria-current', on ? 'true' : 'false');
              // Keep the active tab in view when the strip overflows. Scroll the
              // strip itself, never the page — scrollIntoView would fight the
              // page scroll that triggered this.
              if (on && strip.scrollWidth > strip.clientWidth) {
                strip.scrollTo({
                  left: a.offsetLeft - strip.clientWidth / 2 + a.clientWidth / 2,
                  behavior: 'smooth',
                });
              }
            });
          };

          // The active section is the last heading that has passed the line just
          // below the sticky chrome.
          let queued = false;
          const track = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              // Match html{scroll-padding-top}, which parks an anchored heading
              // just below the sticky chrome. A threshold above that landing
              // point marks the previous section active — off by one.
              const line = strip.getBoundingClientRect().bottom + 28;
              let active = headings[0];
              for (const h of headings) {
                if (h.getBoundingClientRect().top <= line) active = h;
                else break;
              }
              mark(active.id);
            });
          };

          window.addEventListener('scroll', track, { passive: true });
          window.addEventListener('resize', track);
          track();
        }
      }
    </script>

    <style>
      .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      .skip {
        position: absolute;
        left: -9999px;
      }

      /* Desktop shows the nav permanently; the toggle only exists on narrow
         screens, where the nav would otherwise push the page down. */
      .nav-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        margin-left: var(--p-space-03);
        background: none;
        border: 1px solid var(--s-border-subtle);
        border-radius: var(--c-radius);
        cursor: pointer;
      }
      .nav-toggle .bars,
      .nav-toggle .bars::before,
      .nav-toggle .bars::after {
        display: block;
        width: 1rem;
        height: 2px;
        background: var(--s-text-primary);
        border-radius: 1px;
      }
      .nav-toggle .bars {
        position: relative;
      }
      .nav-toggle .bars::before,
      .nav-toggle .bars::after {
        content: '';
        position: absolute;
      }
      .nav-toggle .bars::before {
        top: -5px;
      }
      .nav-toggle .bars::after {
        top: 5px;
      }
      .skip:focus {
        left: 0;
        top: 0;
        z-index: 100;
        background: var(--s-brand);
        color: var(--s-text-on-color);
        padding: var(--p-space-04);
      }

      /* ---------- header ---------- */
      .hdr {
        position: fixed;
        inset: 0 0 auto 0;
        height: var(--c-header-height);
        background: var(--s-background);
        border-bottom: 1px solid var(--s-border-subtle);
        display: flex;
        align-items: center;
        z-index: 50;
      }
      .hdr-name {
        color: var(--s-text-primary);
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        padding: 0 var(--p-space-05);
      }

      /* ---------- shell ---------- */
      .shell {
        display: grid;
        grid-template-columns: var(--c-sidenav-width) minmax(0, 1fr);
        padding-top: var(--c-header-height);
      }

      /* ---------- side navigation ---------- */
      .sidenav {
        position: sticky;
        top: var(--c-header-height);
        height: calc(100vh - var(--c-header-height));
        overflow-y: auto;
        border-right: 1px solid var(--s-border-subtle);
        padding-bottom: var(--p-space-08);
      }

      /* A group is a labelled band, not a collapsible. */
      .grp {
        padding: var(--p-space-05) var(--p-space-04);
      }
      .grp + .grp {
        border-top: 1px solid var(--s-border-subtle);
      }
      .grp h2 {
        margin: 0 0 var(--p-space-03);
        padding: 0 var(--p-space-03);
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--s-text-primary);
      }

      .sidenav ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .sidenav li a {
        display: block;
        padding: var(--p-space-02) var(--p-space-03);
        color: var(--s-text-secondary);
        text-decoration: none;
        border-radius: var(--c-radius);
      }
      .sidenav li a:hover {
        background: var(--s-hover-ui);
        color: var(--s-text-primary);
      }
      .sidenav li a[aria-current='page'] {
        background: var(--s-selected-ui);
        color: var(--s-brand-strong);
        font-weight: 600;
      }

      /* Items nested under a label sit indented from it. */
      .sidenav details ul li a,
      .sidenav .stream ul li a {
        padding-left: var(--p-space-06);
      }

      /* One indent deeper than its group. Needs to out-specify the rule above,
         which would otherwise flatten it back to the parent's indent. */
      .sidenav .stream ul li a.child,
      .sidenav details ul li a.child {
        padding-left: var(--p-space-08);
        font-size: 0.8125rem;
      }
      .sidenav li a.retired {
        color: var(--s-text-helper);
        text-decoration: line-through;
        text-decoration-thickness: 1px;
      }
      /* A group nested inside a stream — its summary carries a link, so the
         label navigates while the chevron only opens. */
      .sidenav li.sub {
        list-style: none;
      }
      .sidenav li.sub > details > summary {
        padding-left: var(--p-space-05);
        font-weight: 400;
      }
      .sidenav li.sub > details[open] > summary {
        font-weight: 600;
      }
      .sidenav li.sub ul li a {
        padding-left: var(--p-space-08);
      }
      .sidenav .flat li a {
        padding-left: var(--p-space-03);
      }

      /* ---------- collapsible item ---------- */
      .sidenav details + details {
        margin-top: var(--p-space-01);
      }
      .sidenav summary {
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: center;
        gap: var(--p-space-02);
        padding: var(--p-space-02) var(--p-space-03);
        border-radius: var(--c-radius);
        color: var(--s-text-primary);
      }
      .sidenav summary::-webkit-details-marker {
        display: none;
      }
      /* Chevron leads the label, as drawn. */
      .sidenav summary::before {
        content: '';
        width: 0.4rem;
        height: 0.4rem;
        flex: none;
        margin-right: var(--p-space-01);
        border-right: 1.5px solid var(--s-text-helper);
        border-bottom: 1.5px solid var(--s-text-helper);
        transform: rotate(45deg) translate(-1px, -1px);
      }
      .sidenav details[open] > summary::before {
        transform: rotate(-135deg) translate(-1px, -1px);
      }
      .sidenav summary:hover {
        background: var(--s-hover-ui);
      }
      .sidenav details[open] > summary {
        font-weight: 600;
      }

      .sidenav details.empty > summary {
        color: var(--s-text-secondary);
      }
      .sidenav .note {
        padding: var(--p-space-02) var(--p-space-03) var(--p-space-02) var(--p-space-06);
        color: var(--s-text-helper);
        font-size: 0.8125rem;
      }

      /* ---------- section navigation ---------- */
      .tabs {
        position: sticky;
        top: var(--c-header-height);
        z-index: 40;
        background: var(--s-background);
        border-bottom: 1px solid var(--s-border-subtle);
        overflow-x: auto;
        scrollbar-width: none;
      }
      .tabs::-webkit-scrollbar {
        display: none;
      }
      /* These nodes are created at runtime, so they carry no Astro scope
         attribute — the selectors must be global to reach them. */
      .tabs :global(ul) {
        display: flex;
        gap: var(--p-space-05);
        list-style: none;
        margin: 0;
        padding: 0 var(--p-space-06);
        white-space: nowrap;
      }
      .tabs :global(a) {
        display: block;
        padding: var(--p-space-04) 0;
        color: var(--s-text-secondary);
        text-decoration: none;
        border-bottom: 2px solid transparent;
        font-size: 0.875rem;
      }
      .tabs :global(a:hover) {
        color: var(--s-text-primary);
      }
      .tabs :global(a[aria-current='true']) {
        color: var(--s-brand-strong);
        border-bottom-color: var(--s-brand);
        font-weight: 600;
      }

      /* ---------- banner ---------- */
      .banner {
        height: 16rem;
        margin: var(--p-space-05) var(--p-space-06) 0;
        background: linear-gradient(
          120deg,
          var(--s-brand-strong),
          var(--s-brand-light) 70%,
          var(--s-accent)
        );
        border-radius: var(--c-radius);
      }

      /* ---------- content ---------- */
      .content {
        max-width: var(--c-content-max);
        padding: var(--p-space-06);
      }
      .content h1 {
        font-size: 1.875rem;
        font-weight: 600;
        line-height: 1.3;
        margin: 0 0 var(--p-space-04);
      }
      .intro {
        font-size: 1.0625rem;
        color: var(--s-text-secondary);
        margin-top: 0;
      }
      .content :global(h2) {
        font-size: 1.25rem;
        font-weight: 600;
        margin: var(--p-space-07) 0 var(--p-space-03);
      }
      .content :global(h3) {
        font-size: 1rem;
        font-weight: 600;
        margin: var(--p-space-05) 0 var(--p-space-02);
      }
      .content :global(table) {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.875rem;
        margin: var(--p-space-04) 0;
      }
      .content :global(th) {
        background: var(--s-layer-01);
        font-weight: 600;
      }
      .content :global(th),
      .content :global(td) {
        border-bottom: 1px solid var(--s-border-subtle);
        padding: var(--p-space-03) var(--p-space-04);
        text-align: left;
        vertical-align: top;
      }
      .content :global(code) {
        font-family: var(--s-font-mono);
        background: var(--s-layer-01);
        border-radius: var(--c-radius);
        padding: 0.1em 0.35em;
        font-size: 0.8125rem;
      }
      .content :global(blockquote) {
        border-left: 3px solid var(--s-brand-light);
        background: var(--s-layer-01);
        margin-left: 0;
        padding: var(--p-space-03) var(--p-space-04);
        color: var(--s-text-secondary);
      }
      .foot {
        border-top: 1px solid var(--s-border-subtle);
        margin-top: var(--p-space-07);
        padding-top: var(--p-space-04);
        color: var(--s-text-helper);
        font-size: 0.8125rem;
      }

      @media (max-width: 48rem) {
        .shell {
          grid-template-columns: minmax(0, 1fr);
        }
        .nav-toggle {
          display: inline-flex;
        }
        /* Collapsed by default so the reader lands on the content, not on
           forty navigation links. */
        .sidenav {
          position: static;
          height: auto;
          border-right: 0;
          border-bottom: 1px solid var(--s-border-subtle);
          display: none;
        }
        .sidenav[data-open] {
          display: block;
        }
        .content,
        .foot {
          padding: var(--p-space-05) var(--p-space-04);
        }
        .hero {
          padding: var(--p-space-06) var(--p-space-04);
        }
        .tabs ul {
          padding: 0 var(--p-space-04);
        }
        /* Wide tables scroll rather than forcing the page sideways. */
        .content :global(table) {
          display: block;
          overflow-x: auto;
          white-space: nowrap;
        }
      }
    </style>
  </body>
</html>

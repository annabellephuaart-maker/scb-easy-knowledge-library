---
import '../styles/tokens.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  /** Tab label shown above the content. */
  tab?: string;
  intro?: string;
  /** Overview pages render a banner; artefact pages do not. */
  banner?: boolean;
}

const { title, tab, intro, banner = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');

const entries = await getCollection('research');

const studies = new Map<string, { label: string; items: typeof entries }>();
for (const entry of entries) {
  const [dir] = entry.id.split('/').slice(1, 2);
  const key = dir ?? 'unfiled';
  if (!studies.has(key)) {
    studies.set(key, { label: key.replace(/_/g, ' · '), items: [] });
  }
  studies.get(key)!.items.push(entry);
}

// Phase two. Listed so the shape of the library is visible, marked absent
// rather than linked to pages that do not exist.
const deferred = ['Developing', 'Elements', 'Components', 'Patterns', 'Guidelines'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · SCB Easy Reference Library</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip">Skip to main content</a>

    <header class="hdr">
      <a class="hdr-name" href="/">SCB Easy Reference Library</a>
    </header>

    <div class="shell">
      <nav class="sidenav" aria-label="Primary">
        <details open>
          <summary>About this Library</summary>
          <ul>
            <li>
              <a href="/" aria-current={here === '' ? 'page' : undefined}>Overview</a>
            </li>
          </ul>
        </details>

        <details open>
          <summary>Research</summary>
          {
            [...studies.values()].map((study) => (
              <>
                <p class="group">{study.label}</p>
                <ul>
                  {study.items.map((item) => (
                    <li>
                      <a
                        href={`/${item.id}`}
                        aria-current={here === `/${item.id}` ? 'page' : undefined}
                      >
                        {item.data.name ?? item.data.title ?? item.id}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ))
          }
        </details>

        {
          deferred.map((section) => (
            <details class="empty">
              <summary>
                {section}
                <span class="badge">phase 2</span>
              </summary>
              <ul>
                <li class="note">Nothing here until tokens and components exist.</li>
              </ul>
            </details>
          ))
        }
      </nav>

      <div class="body">
        {
          tab && (
            <div class="tabs">
              <span class="tab" aria-current="page">
                {tab}
              </span>
            </div>
          )
        }

        {banner && <div class="banner" role="presentation" />}

        <main id="main" class="content">
          <h1>{title}</h1>
          {intro && <p class="intro">{intro}</p>}
          <slot />
        </main>

        <footer class="content foot">
          <p>
            Generated from <code>product-context/</code> at build time. Nothing here is
            hand-maintained — edit the markdown, not the site. See ADR-1.
          </p>
        </footer>
      </div>
    </div>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 0;
        top: 0;
        z-index: 100;
        background: var(--s-brand);
        color: var(--s-text-on-color);
        padding: var(--p-space-04);
      }

      /* ---------- header ---------- */
      .hdr {
        position: fixed;
        inset: 0 0 auto 0;
        height: var(--c-header-height);
        background: var(--s-background);
        border-bottom: 1px solid var(--s-border-subtle);
        display: flex;
        align-items: center;
        z-index: 50;
      }
      .hdr-name {
        color: var(--s-text-primary);
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        padding: 0 var(--p-space-05);
      }

      /* ---------- shell ---------- */
      .shell {
        display: grid;
        grid-template-columns: var(--c-sidenav-width) minmax(0, 1fr);
        padding-top: var(--c-header-height);
      }

      /* ---------- side navigation ---------- */
      .sidenav {
        position: sticky;
        top: var(--c-header-height);
        height: calc(100vh - var(--c-header-height));
        overflow-y: auto;
        border-right: 1px solid var(--s-border-subtle);
        padding: var(--p-space-04) var(--p-space-03) var(--p-space-08);
      }
      .sidenav details + details {
        margin-top: var(--p-space-01);
      }
      .sidenav details.empty {
        border-top: 1px solid var(--s-border-subtle);
        margin-top: var(--p-space-02);
        padding-top: var(--p-space-01);
      }
      .sidenav summary {
        cursor: pointer;
        list-style: none;
        padding: var(--p-space-03) var(--p-space-04);
        font-weight: 600;
        border-radius: var(--c-radius);
        display: flex;
        align-items: center;
        gap: var(--p-space-02);
      }
      .sidenav summary::-webkit-details-marker {
        display: none;
      }
      .sidenav summary::after {
        content: '';
        width: 0.45rem;
        height: 0.45rem;
        margin-left: auto;
        border-right: 1.5px solid var(--s-text-secondary);
        border-bottom: 1.5px solid var(--s-text-secondary);
        transform: rotate(45deg) translate(-1px, -1px);
        flex: none;
      }
      .sidenav details[open] > summary::after {
        transform: rotate(-135deg) translate(-1px, -1px);
      }
      .sidenav summary:hover {
        background: var(--s-hover-ui);
      }
      .sidenav ul {
        list-style: none;
        margin: 0;
        padding: 0 0 var(--p-space-02);
      }
      .sidenav li a {
        display: block;
        padding: var(--p-space-02) var(--p-space-04);
        margin: 1px 0;
        color: var(--s-text-secondary);
        text-decoration: none;
        border-radius: var(--c-radius);
      }
      .sidenav li a:hover {
        background: var(--s-hover-ui);
        color: var(--s-text-primary);
      }
      .sidenav li a[aria-current='page'] {
        background: var(--s-selected-ui);
        color: var(--s-brand-strong);
        font-weight: 600;
      }
      .sidenav .group {
        margin: var(--p-space-03) 0 var(--p-space-01);
        padding: 0 var(--p-space-04);
        font-family: var(--s-font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--s-text-helper);
      }
      .sidenav details.empty > summary {
        color: var(--s-text-helper);
        font-weight: 400;
      }
      .sidenav .badge {
        font-family: var(--s-font-mono);
        font-size: 0.625rem;
        text-transform: uppercase;
        color: var(--s-text-helper);
        background: var(--s-layer-01);
        border-radius: var(--c-radius);
        padding: 1px var(--p-space-02);
      }
      .sidenav .note {
        padding: var(--p-space-02) var(--p-space-04);
        color: var(--s-text-helper);
        font-size: 0.8125rem;
      }

      /* ---------- tab strip ---------- */
      .tabs {
        border-bottom: 1px solid var(--s-border-subtle);
        padding: 0 var(--p-space-06);
      }
      .tab {
        display: inline-block;
        padding: var(--p-space-04) var(--p-space-02);
        border-bottom: 2px solid var(--s-brand);
        font-weight: 500;
      }

      /* ---------- banner ---------- */
      .banner {
        height: 16rem;
        margin: var(--p-space-05) var(--p-space-06) 0;
        background: linear-gradient(
          120deg,
          var(--s-brand-strong),
          var(--s-brand-light) 70%,
          var(--s-accent)
        );
        border-radius: var(--c-radius);
      }

      /* ---------- content ---------- */
      .content {
        max-width: var(--c-content-max);
        padding: var(--p-space-06);
      }
      .content h1 {
        font-size: 1.875rem;
        font-weight: 600;
        line-height: 1.3;
        margin: 0 0 var(--p-space-04);
      }
      .intro {
        font-size: 1.0625rem;
        color: var(--s-text-secondary);
        margin-top: 0;
      }
      .content :global(h2) {
        font-size: 1.25rem;
        font-weight: 600;
        margin: var(--p-space-07) 0 var(--p-space-03);
      }
      .content :global(h3) {
        font-size: 1rem;
        font-weight: 600;
        margin: var(--p-space-05) 0 var(--p-space-02);
      }
      .content :global(table) {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.875rem;
        margin: var(--p-space-04) 0;
      }
      .content :global(th) {
        background: var(--s-layer-01);
        font-weight: 600;
      }
      .content :global(th),
      .content :global(td) {
        border-bottom: 1px solid var(--s-border-subtle);
        padding: var(--p-space-03) var(--p-space-04);
        text-align: left;
        vertical-align: top;
      }
      .content :global(code) {
        font-family: var(--s-font-mono);
        background: var(--s-layer-01);
        border-radius: var(--c-radius);
        padding: 0.1em 0.35em;
        font-size: 0.8125rem;
      }
      .content :global(blockquote) {
        border-left: 3px solid var(--s-brand-light);
        background: var(--s-layer-01);
        margin-left: 0;
        padding: var(--p-space-03) var(--p-space-04);
        color: var(--s-text-secondary);
      }
      .foot {
        border-top: 1px solid var(--s-border-subtle);
        margin-top: var(--p-space-07);
        padding-top: var(--p-space-04);
        color: var(--s-text-helper);
        font-size: 0.8125rem;
      }

      @media (max-width: 48rem) {
        .shell {
          grid-template-columns: minmax(0, 1fr);
        }
        .sidenav {
          position: static;
          height: auto;
          border-right: 0;
          border-bottom: 1px solid var(--s-border-subtle);
        }
      }
    </style>
  </body>
</html>

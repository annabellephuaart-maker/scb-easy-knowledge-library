---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const entries = await getCollection('research');
const studies = entries.filter((e) => e.id.endsWith('study-objective'));
const inputs = entries.filter((e) => !e.id.endsWith('study-objective'));
---

<Base title="SCBX internal reference" eyebrow="Overview">
  <p>
    A browsable view of the project's research artefacts. Content is read from
    <code>product-context/</code> when the site builds, so this is never out of step with
    the source.
  </p>

  <dl class="counts">
    <div><dt>Studies</dt><dd>{studies.length}</dd></div>
    <div><dt>Inputs</dt><dd>{inputs.length}</dd></div>
    <div><dt>Artefacts</dt><dd>{entries.length}</dd></div>
  </dl>

  <h2 id="research">Research</h2>
  {
    entries.length === 0 ? (
      <p>No research artefacts found in <code>product-context/research/</code>.</p>
    ) : (
      <ul>
        {entries.map((entry) => (
          <li>
            <a href={`/${entry.id}`}>{entry.data.name ?? entry.data.title ?? entry.id}</a>
            {entry.data.status && <span class="tag">{entry.data.status}</span>}
          </li>
        ))}
      </ul>
    )
  }

  <h2>Design system</h2>
  <p>
    Not yet. Component and token documentation lands in phase two, once tokens exist.
    Building those pages before there are components to document would mean writing them
    twice.
  </p>

  <style>
    .counts {
      display: flex;
      gap: var(--s-space-block);
      border: 1px solid var(--s-border);
      padding: var(--s-space-inline);
      margin: var(--s-space-block) 0;
    }
    .counts div {
      margin: 0;
    }
    .counts dt {
      font-family: var(--s-font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--s-text-muted);
    }
    .counts dd {
      margin: 0;
      font-family: var(--s-font-mono);
      font-size: 1.5rem;
    }
    .tag {
      font-family: var(--s-font-mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--s-text-muted);
      margin-left: var(--p-size-2);
    }
  </style>
</Base>

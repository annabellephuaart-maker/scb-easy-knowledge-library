---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CompetitorGrid from '../components/CompetitorGrid.astro';
import ScreenMatrix from '../components/ScreenMatrix.astro';
import AppGallery from '../components/AppGallery.astro';
import { galleries } from '../data/audit-galleries';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

/**
 * Section imagery for app pages.
 *
 * The screens live in the site, the prose lives in product-context, and the
 * markdown must not carry site-specific image paths. So the rendered HTML is
 * post-processed here: the app icon lands under "About the company" and a
 * screen strip under "About the app", keyed on the headings the pages already
 * use.
 */
const gallery = entry.data.gallery ? galleries[entry.data.gallery] : undefined;

const esc = (t: string) =>
  t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const strip = (count: number) =>
  `<div class="sec-strip">${gallery!.screens
    .slice(0, count)
    .map(
      (s) =>
        `<figure><img src="${s.src}" alt="${esc(s.caption)}" loading="lazy" /><figcaption>${esc(
          s.caption
        )}</figcaption></figure>`
    )
    .join('')}</div>`;

const after = (html: string, heading: RegExp, insert: string) =>
  html.replace(heading, (m) => m + insert);

let sectioned: string | null = null;
if (gallery && entry.rendered?.html) {
  let html = entry.rendered.html;
  if (gallery.icon) {
    html = after(
      html,
      /<h2[^>]*>\s*1\.\s*About the company\s*<\/h2>/i,
      `<figure class="sec-logo"><img src="${gallery.icon}" alt="${esc(
        gallery.name
      )} app icon" width="96" height="96" /></figure>`
    );
  }
  if (gallery.screens.length) {
    html = after(html, /<h2[^>]*>\s*3\.\s*About the app\s*<\/h2>/i, strip(5));
    html = after(html, /<h2[^>]*>\s*4\.\s*Key screens\s*<\/h2>/i, strip(10));
  }
  sectioned = html;
}

const title = entry.data.name ?? entry.data.title ?? entry.id;

// Surface the evidence-quality signals rather than burying them in the prose.
const meta = [
  ['Status', entry.data.status],
  ['Study', entry.data.study],
  ['Type', entry.data.input_type],
  ['Evidence quality', entry.data.evidence_quality],
  ['Confidence', entry.data.confidence],
  ['Source of truth', entry.data.ssot === false ? 'no — reference only' : undefined],
].filter(([, v]) => v !== undefined);
---

<Base title={title}>
  {
    meta.length > 0 && (
      <dl class="meta">
        {meta.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {/* The artefact declares which visual it needs; the site supplies it.
      Keeps the markdown free of component markup and site-specific paths. */}
  {
    entry.data.visual === 'competitor-grid' && (
      <section>
        <h2 id="the-apps">The apps</h2>
        <CompetitorGrid />
      </section>
    )
  }

  {
    entry.data.visual === 'screen-matrix' && (
      <section>
        <h2 id="the-matrix">Screen matrix</h2>
        <ScreenMatrix />
      </section>
    )
  }

  {
    entry.data.gallery && (
      <section>
        <h2 id="screens">Screens</h2>
        <AppGallery slug={entry.data.gallery} />
      </section>
    )
  }

  <article>
    {sectioned ? <Fragment set:html={sectioned} /> : <Content />}
  </article>

  <p class="source">
    Source: <code>product-context/research/{entry.id}.md</code>
  </p>

  <style>
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--p-space-07);
      background: var(--s-layer-01);
      padding: var(--p-space-05);
      margin: 0 0 var(--p-space-07);
    }
    .meta div {
      margin: 0;
    }
    .meta dt {
      font-family: var(--s-font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--s-text-helper);
    }
    .meta dd {
      margin: var(--p-space-02) 0 0;
      font-size: 0.875rem;
    }
    article :global(.sec-logo) {
      margin: var(--p-space-04) 0;
      padding: var(--p-space-04);
      border: 1px solid var(--s-border-subtle);
      border-radius: var(--c-radius);
      display: inline-block;
      background: var(--s-background);
    }
    article :global(.sec-logo img) {
      display: block;
      width: 5rem;
      height: 5rem;
      border-radius: 14px;
    }
    article :global(.sec-strip) {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
      gap: var(--p-space-04);
      margin: var(--p-space-04) 0 var(--p-space-05);
    }
    article :global(.sec-strip figure) {
      margin: 0;
    }
    article :global(.sec-strip img) {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1.9;
      object-fit: cover;
      object-position: top center;
      border: 1px solid var(--s-border-subtle);
      border-radius: var(--c-radius);
      background: var(--s-layer-01);
    }
    article :global(.sec-strip figcaption) {
      margin-top: var(--p-space-02);
      font-size: 0.6875rem;
      line-height: 1.4;
      color: var(--s-text-helper);
    }
    .source {
      margin-top: var(--p-space-08);
      font-family: var(--s-font-mono);
      font-size: 0.75rem;
      color: var(--s-text-helper);
    }
  </style>
</Base>
